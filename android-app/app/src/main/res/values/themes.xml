<resources>
    <style name="Theme.Paradiso" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/paradiso_navy</item>
        <item name="android:navigationBarColor">@color/paradiso_navy</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Paradiso.Scanner" parent="Theme.Paradiso">
        <item name="android:windowBackground">@color/paradiso_navy</item>
        <item name="android:colorAccent">@color/paradiso_accent</item>
        <item name="android:textColor">@color/paradiso_text</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
